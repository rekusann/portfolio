---
import "../styles/global.css";

const projects = [
  /*template
  {
    id: "sample-project",                  // 固有ID（英数字・ハイフン推奨）
    title: "作品タイトル",                 // 一覧・モーダルのタイトル
    type: "Graphic Design / Poster",       // 一覧に表示する制作タイプ
    year: "2026",                          // 一覧に表示する年
    category: "graphic",                   // "graphic" / "video" / "web"
    size: "tall",                          // カードサイズ。不要なら ""
    image: "images/sample-thumbnail.webp", // 一覧用サムネイル（public以下）
    date: "2026",                           // モーダルの公開日
    duration: "2週間",                      // モーダルの製作期間
    client: "クライアント名",               // モーダルのクライアント名
    description: "text",               // 説明
    mediaType: "image",                    // "image" / "youtube" / "x"
    media: "images/sample-full.webp",      // 画像パス、YouTube URL、またはX投稿URL
    alt: "作品画像の説明"                   // 画像の代替テキスト
  },
  */
  {
    id: "01",
    title: "Creator Hive 告知画像",
    type: "Graphic Design / Poster",
    year: "2026",
    category: "graphic",
    size: "tall",
    image: "images/01.webp",
    date: "2026.10.01",
    duration: "1日",
    client: "株式会社VJup",
    description: "シェアハウス事業「Creator Hive」のX用のサービス告知画像を制作しました。",
    mediaType: "image",
    media: "images/01.webp",
    alt: "Creator Hive Poster"
  },
  {
    id: "02",
    title: "Creator Hive 告知画像",
    type: "Graphic Design / Poster",
    year: "2026",
    category: "video",
    size: "tall",
    image: "images/02.webp",
    date: "2026.10.01",
    duration: "1日",
    client: "株式会社VJup",
    description: "シェアハウス事業「Creator Hive」のX用のサービス告知画像を制作しました。",
    mediaType: "youtube",
    media: "https://www.youtube.com/watch?v=l2DJIymxy08",
    alt: "Creator Hive Poster"
  },
  {
    id: "03",
    title: "Creator Hive 告知画像",
    type: "Graphic Design / Poster",
    year: "2026",
    category: "graphic",
    size: "tall",
    image: "images/03.webp",
    date: "2026.10.01",
    duration: "1日",
    client: "株式会社VJup",
    description: "シェアハウス事業「Creator Hive」のX用のサービス告知画像を制作しました。",
    mediaType: "image",
    media: "images/03.webp",
    alt: "Creator Hive Poster"
  },
  {
    id: "04",
    title: "Creator Hive 告知画像",
    type: "Graphic Design / Poster",
    year: "2026",
    category: "graphic",
    size: "tall",
    image: "images/04.webp",
    date: "2026.10.01",
    duration: "1日",
    client: "株式会社VJup",
    description: "シェアハウス事業「Creator Hive」のX用のサービス告知画像を制作しました。",
    mediaType: "image",
    media: "images/04.webp",
    alt: "Creator Hive Poster"
  }
];

const categories = [
  { key: "all", label: "すべて" },
  { key: "graphic", label: "グラフィックデザイン" },
  { key: "video", label: "映像制作" },
  { key: "web", label: "Webデザイン" }
];
---

<html lang="ja">

<head>
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Graphic design, video and web design portfolio.">
    <title>nihilnovem.work</title>
</head>

<body>

    <header class="site-header">
        <span class="site-logo"></span>

        <div class="character-area">
            <button class="character-button" id="characterButton" aria-label="プロフィールを開く" aria-expanded="false"
                aria-controls="profileBubble">
                <img src={`${import.meta.env.BASE_URL}images/logo.png`} alt="" class="character-icon">
            </button>

            <div class="profile-bubble" id="profileBubble" aria-hidden="true" inert>
                <button class="bubble-close" id="bubbleClose" type="button" aria-label="プロフィールを閉じる">×</button>
                <p class="bubble-title">Hi, I'm reku.</p>
                <p class="bubble-text">主にデザインと映像をつくっています。特にeSports・Y2Kデザインが好き。<a href="https://studio.revati.jp/"
                        target="_blank" rel="noopener noreferrer">REVATI Studio</a>で活動しています。</p>
                <p class="bubble-caption">20y/o - from ♥ Hokkaido, Japan</p>
            </div>
        </div>

        <div class="url-area">
            <a href="https://x.com/nihilnovem" target="_blank" rel="noopener noreferrer"><img src={`${import.meta.env.BASE_URL}images/x-logo.svg`}
                    alt="x-logo" class="x-logo"></a>
        </div>
        </div>
    </header>

    <main>
        <section class="toolbar" aria-label="作品の検索と絞り込み">
            <label class="search">
                <span class="sr-only">検索</span>
                <input id="searchInput" type="search" placeholder="検索する" autocomplete="off">
            </label>
            <nav class="filters" aria-label="カテゴリで絞り込み">
                <button class="filter active" type="button" data-category="all"> すべて </button>
                <button class="filter" type="button" data-category="graphic"> グラフィックデザイン </button>
                <button class="filter" type="button" data-category="video"> 映像制作 </button>
                <button class="filter" type="button" data-category="web"> Webデザイン </button>
            </nav>
        </section>

        <section class="portfolio" id="portfolio" aria-live="polite">
            {projects.map((project) => (
                <article
                    class:list={["project", project.size]}
                    data-project-id={project.id}
                    data-title={project.title.toLowerCase()}
                    data-type={project.type.toLowerCase()}
                    data-category={project.category}
                >
                    <a href={project.href || "#"} class="project-link" aria-label={`${project.title} — ${project.type}`}>
                        <div class="image-wrap">
                            <img src={`${import.meta.env.BASE_URL}${project.image.replace(/^\//, "")}`} alt={project.title} />
                        </div>
                        <div class="meta">
                            <span>{project.title}</span>
                            <span>{project.type} · {project.year}</span>
                        </div>
                    </a>
                </article>
            ))}
        </section>
        <p class="empty" id="emptyState" hidden="">該当する作品がありません。</p>
    </main>


    <!-- Project detail modal -->
    <section class="project-modal" id="projectModal" aria-hidden="true" inert>
        <div class="project-modal__backdrop" data-modal-close></div>
        <article class="project-modal__panel" role="dialog" aria-modal="true"
            aria-labelledby="modalTitle" aria-describedby="modalDescription">
            <button class="project-modal__close" id="modalClose" type="button"
                aria-label="作品詳細を閉じる">×</button>

            <div class="project-modal__header">
                <div>
                    <p class="project-modal__eyebrow" id="modalCategory">CATEGORY</p>
                    <h2 id="modalTitle">タイトル</h2>
                    <p class="project-modal__description" id="modalDescription"></p>
                </div>
                <button class="project-modal__share" id="modalShare" type="button">リンクをコピー</button>
            </div>

            <dl class="project-modal__details">
                <div><dt>公開日</dt><dd id="modalDate">未設定</dd></div>
                <div><dt>製作期間</dt><dd id="modalDuration">未設定</dd></div>
                <div><dt>クライアント</dt><dd id="modalClient">未設定</dd></div>
            </dl>

            <div class="project-modal__media" id="modalMedia"></div>
        </article>
    </section>

    <div class="image-lightbox" id="imageLightbox" aria-hidden="true" inert>
        <button class="image-lightbox__close" id="lightboxClose" type="button"
            aria-label="全画面表示を閉じる">×</button>
        <img id="lightboxImage" src="" alt="">
    </div>

    <script>
      const input = document.querySelector("#searchInput");
      const buttons = [...document.querySelectorAll(".filter")];
      const projectCards = [...document.querySelectorAll(".project")];
      const empty = document.querySelector("#emptyState");
      let activeCategory = "all";

      function update() {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        projectCards.forEach((project) => {
          const matchesCategory = activeCategory === "all" || project.dataset.category === activeCategory;
          const searchable = [project.dataset.title, project.dataset.type, project.dataset.category].join(" ");
          const show = matchesCategory && (!query || searchable.includes(query));
          project.hidden = !show;
          if (show) visible++;
        });
        empty.hidden = visible !== 0;
      }
      input.addEventListener("input", update);
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          activeCategory = button.dataset.category;
          buttons.forEach((item) => item.classList.toggle("active", item === button));
          update();
        });
      });
      update();
    </script>

    <script>
        const characterButton =
            document.querySelector("#characterButton");

        const characterIcon =
            document.querySelector(".character-icon");

        const profileBubble =
            document.querySelector("#profileBubble");

        if (
            characterButton &&
            characterIcon &&
            profileBubble
        ) {
            let isOpen = false;

            function setBubble(open) {
                isOpen = open;

                profileBubble.classList.toggle("is-open", open);
                characterButton.setAttribute(
                    "aria-expanded",
                    String(open)
                );

                profileBubble.setAttribute(
                    "aria-hidden",
                    String(!open)
                );

                profileBubble.inert = !open;
            }

            characterButton.addEventListener("click", () => {
                setBubble(!isOpen);
            });

            document.addEventListener("click", (event) => {
                if (
                    !characterButton.contains(event.target) &&
                    !profileBubble.contains(event.target)
                ) {
                    setBubble(false);
                }
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    setBubble(false);
                }
            });

            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            );

            function scheduleSquish() {
                if (reduceMotion.matches) return;

                const delay = 3000 + Math.random() * 5000;

                window.setTimeout(() => {
                    characterIcon.classList.remove(
                        "is-squishing"
                    );

                    void characterIcon.offsetWidth;

                    characterIcon.classList.add(
                        "is-squishing"
                    );

                    scheduleSquish();
                }, delay);
            }

            characterIcon.addEventListener(
                "animationend",
                () => {
                    characterIcon.classList.remove(
                        "is-squishing"
                    );
                }
            );

            scheduleSquish();

            const bubbleClose = document.querySelector("#bubbleClose");

            if (bubbleClose && profileBubble && characterButton) {
                bubbleClose.addEventListener("click", () => {
                    setBubble(false);
                    characterButton.focus();
                });
            }

        }
    </script>


    <script type="application/json" id="project-data" set:html={JSON.stringify(projects)}></script>

    <script>
        /*
         * 作品情報はファイル上部の const projects から読み込みます。
         * mediaType: "image" / "youtube" / "x"
         */
        const projectDataElement = document.querySelector("#project-data");
        const projectData = projectDataElement ? JSON.parse(projectDataElement.textContent) : [];
        const projectDetails = Object.fromEntries(projectData.map((project) => [project.id, project]));

        const projectModal = document.querySelector("#projectModal");
        const modalClose = document.querySelector("#modalClose");
        const modalTitle = document.querySelector("#modalTitle");
        const modalCategory = document.querySelector("#modalCategory");
        const modalDescription = document.querySelector("#modalDescription");
        const modalDate = document.querySelector("#modalDate");
        const modalDuration = document.querySelector("#modalDuration");
        const modalClient = document.querySelector("#modalClient");
        const modalMedia = document.querySelector("#modalMedia");
        const modalShare = document.querySelector("#modalShare");
        const imageLightbox = document.querySelector("#imageLightbox");
        const lightboxImage = document.querySelector("#lightboxImage");
        const lightboxClose = document.querySelector("#lightboxClose");
        let currentProjectId = null;
        let previousFocus = null;

        function youtubeEmbedUrl(url) {
            try {
                const parsed = new URL(url);
                let videoId = "";
                if (parsed.hostname.includes("youtu.be")) {
                    videoId = parsed.pathname.slice(1);
                } else if (parsed.hostname.includes("youtube.com")) {
                    videoId = parsed.searchParams.get("v") || parsed.pathname.split("/").filter(Boolean).pop();
                }
                return videoId ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}` : "";
            } catch {
                return "";
            }
        }

        function openProject(projectId, updateUrl = true) {
            const data = projectDetails[projectId];
            if (!data || !projectModal) return;

            currentProjectId = projectId;
            previousFocus = document.activeElement;
            modalTitle.textContent = data.title || "タイトル";
            modalCategory.textContent = data.type || "";
            modalDescription.textContent = data.description || "";
            modalDate.textContent = data.date || "未設定";
            modalDuration.textContent = data.duration || "未設定";
            modalClient.textContent = data.client || "未設定";
            modalMedia.replaceChildren();

            if (data.mediaType === "youtube") {
                const embedUrl = data.media ? youtubeEmbedUrl(data.media) : "";
                if (embedUrl) {
                    const frame = document.createElement("iframe");
                    frame.src = embedUrl;
                    frame.title = `${data.title} — YouTube動画`;
                    frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
                    frame.allowFullscreen = true;
                    frame.loading = "lazy";
                    modalMedia.append(frame);
                } else {
                    modalMedia.innerHTML = '<p class="project-modal__media-note">YouTubeの動画URLを設定すると、ここに埋め込まれます。</p>';
                }
            } else if (data.mediaType === "x") {
                if (data.media) {
                    const blockquote = document.createElement("blockquote");
                    blockquote.className = "twitter-tweet";
                    const link = document.createElement("a");
                    link.href = data.media;
                    link.textContent = "投稿を読み込む";
                    blockquote.append(link);
                    modalMedia.append(blockquote);

                    // X公式ウィジェットで投稿を埋め込み表示
                    if (window.twttr?.widgets?.load) {
                        window.twttr.widgets.load(modalMedia);
                    } else {
                        const existingScript = document.querySelector('script[src="https://platform.twitter.com/widgets.js"]');
                        if (!existingScript) {
                            const script = document.createElement("script");
                            script.src = "https://platform.twitter.com/widgets.js";
                            script.async = true;
                            script.charset = "utf-8";
                            script.onload = () => window.twttr?.widgets?.load?.(modalMedia);
                            document.head.append(script);
                        } else {
                            existingScript.addEventListener("load", () => window.twttr?.widgets?.load?.(modalMedia), { once: true });
                        }
                    }
                } else {
                    modalMedia.innerHTML = '<p class="project-modal__media-note">Xの投稿URLを設定すると、ここに埋め込まれます。</p>';
                }
            } else if (data.media) {
                const wrap = document.createElement("div");
                wrap.className = "project-modal__image-wrap";
                const image = document.createElement("img");
                image.src = data.media.startsWith("http") ? data.media : `${import.meta.env.BASE_URL}${data.media.replace(/^\//, "")}`;
                image.alt = data.alt || data.title;
                image.loading = "lazy";
                const fullscreen = document.createElement("button");
                fullscreen.className = "project-modal__fullscreen";
                fullscreen.type = "button";
                fullscreen.textContent = "画像を全画面表示 ↗";
                fullscreen.addEventListener("click", () => openLightbox(data.media.startsWith("http") ? data.media : `${import.meta.env.BASE_URL}${data.media.replace(/^\//, "")}`, data.alt || data.title));
                wrap.append(image, fullscreen);
                modalMedia.append(wrap);
            }

            projectModal.classList.add("is-open");
            projectModal.setAttribute("aria-hidden", "false");
            projectModal.inert = false;
            document.body.classList.add("modal-is-open");

            if (updateUrl) {
                const url = new URL(window.location.href);
                url.searchParams.set("project", projectId);
                history.pushState({ projectId }, "", url);
            }
            modalClose.focus();
        }

        function closeProject(updateUrl = true) {
            if (!projectModal?.classList.contains("is-open")) return;
            projectModal.classList.remove("is-open");
            projectModal.setAttribute("aria-hidden", "true");
            projectModal.inert = true;
            modalMedia.replaceChildren();
            document.body.classList.remove("modal-is-open");
            closeLightbox();

            if (updateUrl) {
                const url = new URL(window.location.href);
                url.searchParams.delete("project");
                history.pushState({}, "", url);
            }
            if (previousFocus && typeof previousFocus.focus === "function") previousFocus.focus();
        }

        function openLightbox(src, alt) {
            lightboxImage.src = src;
            lightboxImage.alt = alt;
            imageLightbox.classList.add("is-open");
            imageLightbox.setAttribute("aria-hidden", "false");
            imageLightbox.inert = false;
            lightboxClose.focus();
        }

        function closeLightbox() {
            if (!imageLightbox?.classList.contains("is-open")) return;
            imageLightbox.classList.remove("is-open");
            imageLightbox.setAttribute("aria-hidden", "true");
            imageLightbox.inert = true;
            lightboxImage.src = "";
        }

        document.querySelectorAll(".project").forEach((card) => {
            const link = card.querySelector(".project-link");
            const projectId = card.dataset.projectId;
            if (!link || !projectId) return;
            link.addEventListener("click", (event) => {
                event.preventDefault();
                openProject(projectId);
            });
        });

        modalClose?.addEventListener("click", () => closeProject());
        projectModal?.querySelector("[data-modal-close]")?.addEventListener("click", () => closeProject());
        lightboxClose?.addEventListener("click", closeLightbox);

        modalShare?.addEventListener("click", async () => {
            const url = window.location.href;
            try {
                await navigator.clipboard.writeText(url);
                modalShare.textContent = "コピーしました";
            } catch {
                window.prompt("このリンクをコピーしてください", url);
            }
            window.setTimeout(() => { modalShare.textContent = "リンクをコピー"; }, 1800);
        });

        window.addEventListener("popstate", () => {
            const projectId = new URL(window.location.href).searchParams.get("project");
            if (projectId && projectDetails[projectId]) {
                openProject(projectId, false);
            } else {
                closeProject(false);
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                if (imageLightbox?.classList.contains("is-open")) closeLightbox();
                else closeProject();
            }
        });

        // URLに ?project=作品ID があれば、対応する作品のポップアップを開く
        const initialProjectId = new URL(window.location.href).searchParams.get("project");
        if (initialProjectId && projectDetails[initialProjectId]) {
            openProject(initialProjectId, false);
        }
    </script>

</body>

</html>
